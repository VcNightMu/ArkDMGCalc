{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkDMGCalc",
  "version": "1.0.0",
  "identifier": "com.arkdmgcalc.desktop",
  "build": {
    "frontendDist": "../src/frontend",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ArkDMGCalc - 明日方舟干员输出计算器",
        "width": 1400,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
